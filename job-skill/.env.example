# 이 파일을 .env 로 복사해 비밀번호를 정한다(.env 는 저장소에 올리지 않는다).
POSTGRES_PASSWORD=여기에_비밀번호
DATABASE_URL=postgresql://career:여기에_비밀번호@localhost:5433/career
# Airflow 묶음 (docker-compose.airflow.yml)
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=여기에_비밀번호
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=파이썬으로_만든_키
AIRFLOW_JWT_SECRET=무작위_문자열
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# AWS 브랜치: 서빙 DB(RDS). 있으면 파이프라인은 RDS 로(암호화 접속), 시험은 위 DATABASE_URL(로컬)로
RDS_HOST=career-db.xxxx.ap-northeast-2.rds.amazonaws.com
RDS_PASSWORD=RDS_마스터_암호
# 관리자 추출 검토와 같은 namespace. 비어 있거나 off이면 검토 큐 연결을 사용하지 않는다.
# 웹 로컬 검토는 local-review, 스테이징 검토는 staging. 실제 파이프라인 환경에 맞춰 지정한다.
CAREER_PIPELINE_NAMESPACE=
