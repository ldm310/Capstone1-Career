# 이 파일을 .env 로 복사해 비밀번호를 정한다(.env 는 저장소에 올리지 않는다).
POSTGRES_PASSWORD=여기에_비밀번호
DATABASE_URL=postgresql://career:여기에_비밀번호@localhost:5433/career
# Airflow 묶음 (docker-compose.airflow.yml)
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=여기에_비밀번호
AIRFLOW_ADMIN_PASSWORD=관리_화면_비밀번호
AIRFLOW_FERNET_KEY=파이썬으로_만든_키
AIRFLOW_JWT_SECRET=무작위_문자열
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
